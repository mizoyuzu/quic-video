+static uint64_t monotonic_us()
+{
+	struct timespec ts;
+	clock_gettime(CLOCK_MONOTONIC, &ts);
+	return (uint64_t)ts.tv_sec * 1000000ULL + (uint64_t)ts.tv_nsec / 1000ULL;
+}
+
+static void jsonl_close(struct moq_source *ctx)
+{
+	if (ctx->jsonl_file) {
+		std::fflush(ctx->jsonl_file);
+		std::fclose(ctx->jsonl_file);
+		ctx->jsonl_file = nullptr;
+	}
+}
+
+static void jsonl_open(struct moq_source *ctx)
+{
+	jsonl_close(ctx);
+	if (ctx->jsonl_path && ctx->jsonl_path[0])
+		ctx->jsonl_file = std::fopen(ctx->jsonl_path, "ab");
+}
+
+static void jsonl_event(struct moq_source *ctx, const char *event, uint64_t pts_us, size_t payload_bytes,
+				 bool keyframe)
+{
+	if (!ctx->jsonl_file)
+		return;
+	std::fprintf(ctx->jsonl_file,
+		     "{\"schema_version\":1,\"role\":\"obs_subscriber\",\"event\":\"%s\","
+		     "\"monotonic_us\":%llu,\"media_pts_us\":%llu,\"payload_bytes\":%zu,"
+		     "\"keyframe\":%s,\"sequence\":%llu}\n",
+		     event, (unsigned long long)monotonic_us(), (unsigned long long)pts_us, payload_bytes,
+		     keyframe ? "true" : "false", (unsigned long long)ctx->jsonl_sequence++);
+	std::fflush(ctx->jsonl_file);
+}
